# Variables de entorno de Pistaklero.
#
# En desarrollo, ./start.sh escribe solo las de Supabase local en .env.local.
# Las demás (claves de servicios externos) agregalas vos en .env.local, fuera del bloque generado.
# En producción se cargan en Vercel.

# URL pública del sitio (sin barra final).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta: ignora RLS. Solo en el servidor.
SUPABASE_SECRET_KEY=

# Login con OAuth: proveedores con credenciales configuradas en Supabase, separados por coma.
# Ejemplo: google,github. Vacío = solo link mágico por email.
AUTH_OAUTH_PROVIDERS=

# Emails. En producción: clave de Resend y remitente verificado. En desarrollo van a Mailpit.
RESEND_API_KEY=
EMAIL_FROM="Pistaklero <hola@pistaklero.com>"
MAILPIT_URL=http://127.0.0.1:54324
# Secreto para POST /api/internal/outbox (lo usa el cron que vacía la cola de emails).
OUTBOX_SECRET=

# Carga asistida con IA de ofertas importadas (panel de admin). Sin clave, el formulario se completa a mano.
ANTHROPIC_API_KEY=

# Email de contacto que se muestra en las páginas legales y de accesibilidad.
NEXT_PUBLIC_CONTACT_EMAIL=

# Lo genera Vercel para sus crons (vercel.json): autoriza GET /api/internal/cron.
CRON_SECRET=
