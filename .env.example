# Variables de entorno de Pistaklero.
#
# En desarrollo, ./start.sh escribe solo las de Supabase local en .env.local.
# Las demás (claves de servicios externos) agregalas vos en .env.local, fuera del bloque generado.
# En producción se cargan en Vercel.

# URL pública del sitio (sin barra final).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta: ignora RLS. Solo en el servidor.
SUPABASE_SECRET_KEY=

# Login con OAuth: proveedores con credenciales configuradas en Supabase, separados por coma.
# Ejemplo: google,github. Vacío = solo link mágico por email.
AUTH_OAUTH_PROVIDERS=
